# copy to .env (gitignored) and fill in; source with: set -a; source .env; set +a
# stackql-deploy, the stackql MCP configs (.vscode/mcp.json, .github/mcp.json)
# and the agents all read this file.

# azure: a service principal with Contributor on the subscription (provider auth)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# cloudflare: an API token with DNS edit on the demo zone (provider auth)
CLOUDFLARE_API_TOKEN=

# stack variables (xops/stackql_manifest.yml globals)
AZURE_SUBSCRIPTION_ID=
AZURE_VM_SSH_PUBLIC_KEY="ssh-ed25519 AAAA... you@example.com"
CLOUDFLARE_ZONE_ID=
# host.domain is the A record the stack creates and the SRE agent checks
DEMO_HOST=azure-demo
DEMO_DOMAIN=stackql.xyz

# agents (demo 3): the Azure OpenAI account and deployment the stack creates.
# scripts/openai-env.sh fills these from the stack exports and list_keys.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_KEY=
